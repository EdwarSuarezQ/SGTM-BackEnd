# Puerto del servidor
PORT=4000

# URL de conexión a MongoDB
# Formato: mongodb://[usuario:contraseña@]host[:puerto]/nombre_base_datos
MONGODB_URI=mongodb://localhost:27017/sgtm-crud

# Secreto para firmar tokens JWT
# IMPORTANTE: Cambiar en producción por una cadena aleatoria y segura
JWT_SECRET=tu_secreto_super_seguro_aqui_cambiar_en_produccion

# Entorno de ejecución
NODE_ENV=development

# Configuración de CORS (opcional)
# CORS_ORIGIN=http://localhost:5173

# Tiempo de expiración del token JWT (opcional, por defecto 12h)
JWT_EXPIRE=12h
